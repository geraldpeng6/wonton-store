{
  "agents": ["com.nousresearch.hermes", "ai.openclaw.agent", "ai.omp.agent", "ai.codex", "ai.claude-code",
    "ai.deepseek.dsh"],
  "needs": [
    {
      "id": "photos",
      "title": { "zh": "备份照片", "en": "Back up photos" },
      "plugins": ["app.immich.immich"]
    },
    {
      "id": "music",
      "title": { "zh": "听音乐", "en": "Listen to music" },
      "plugins": ["org.navidrome.navidrome"]
    },
    {
      "id": "documents",
      "title": { "zh": "整理文档", "en": "Organize documents" },
      "plugins": ["com.paperless-ngx.paperless-ngx"]
    },
    {
      "id": "sync",
      "title": { "zh": "同步文件", "en": "Sync files" },
      "plugins": ["net.syncthing.syncthing", "com.nextcloud.nextcloud"]
    },
    {
      "id": "devices",
      "title": { "zh": "控制家里的设备", "en": "Control home devices" },
      "plugins": ["io.home-assistant.home-assistant"]
    },
    {
      "id": "notes",
      "title": { "zh": "记笔记", "en": "Take notes" },
      "plugins": ["com.usememos.memos"]
    },
    {
      "id": "rss",
      "title": { "zh": "看订阅", "en": "Read feeds" },
      "plugins": ["app.miniflux.miniflux"]
    },
    {
      "id": "budget",
      "title": { "zh": "记账", "en": "Track spending" },
      "plugins": ["org.actualbudget.actual"]
    },
    {
      "id": "movies",
      "title": { "zh": "找片看", "en": "Find something to watch" },
      "plugins": ["app.seerr.seerr"]
    }
  ],
  "prompts": [
    { "zh": "你能帮我做什么", "en": "What can you help me with" },
    { "zh": "我想备份手机里的照片，该怎么做", "en": "How can I back up the photos on my phone" },
    { "zh": "怎么再加一台手机", "en": "How do I add another phone" }
  ]
}
